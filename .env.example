# Copy to .env.local (gitignored). On Vercel, set these in the project's Environment Variables.

# AI shopkeeper (Claude)
ANTHROPIC_API_KEY=sk-ant-...
SHOPKEEPER_MODEL=claude-haiku-4-5
# Only needed if the key is workspace/identity-linked (the API 400s without it).
# ANTHROPIC_WORKSPACE_ID=...

# Supabase — inventory, auth, image storage.
# URL + anon key are browser-safe (security is via Row Level Security). Prefix
# with VITE_ so the client bundle can read them.
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>
# Service role key is SERVER-ONLY (Vercel env + local seed). Never prefix with
# VITE_ and never ship to the browser — it bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# PSA cert lookup (optional; account must be API-approved by PSA)
# PSA_API_TOKEN=...
