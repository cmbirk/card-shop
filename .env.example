# Copy to .env.local (gitignored). On Vercel, set these in the project's Environment Variables.

# AI shopkeeper (Claude)
ANTHROPIC_API_KEY=sk-ant-...
SHOPKEEPER_MODEL=claude-haiku-4-5
# Only needed if the key is workspace/identity-linked (the API 400s without it).
# ANTHROPIC_WORKSPACE_ID=...

# Supabase — inventory, auth, image storage.
# URL + anon key are browser-safe (security is via Row Level Security). Prefix
# with VITE_ so the client bundle can read them.
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>
# Service role key is SERVER-ONLY (Vercel env + local seed). Never prefix with
# VITE_ and never ship to the browser — it bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# PSA cert lookup (optional; account must be API-approved by PSA)
# PSA_API_TOKEN=...

# Stripe — checkout. Use TEST keys until launch (Dashboard → Developers → API keys, "Test mode" on).
# Secret key is SERVER-ONLY (Vercel env + .env.local); never prefix with VITE_.
STRIPE_SECRET_KEY=sk_test_...
# Publishable key is browser-safe (VITE_ so the client can read it). Hosted Checkout doesn't
# strictly need it client-side, but it's here for the embedded/Payment Element path later.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook signing secret for /api/stripe-webhook. Local: `stripe listen --forward-to
# localhost:5199/api/stripe-webhook` prints one (whsec_...). Prod: Dashboard → Developers →
# Webhooks → add endpoint https://toploadercards.com/api/stripe-webhook → Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_...
# Where Stripe sends the customer back after paying (success/cancel URLs). Defaults to the
# request origin if unset.
# PUBLIC_ORIGIN=https://toploadercards.com
